{
  "//": "O dev server encaminha cada rota para o microsservico dono dela. Assim o navegador ve uma origem so, sem CORS, e o codigo do frontend nao carrega URLs absolutas.",
  "/api/produtos": {
    "target": "http://localhost:8081",
    "secure": false,
    "changeOrigin": true
  },
  "/api/estoque": {
    "target": "http://localhost:8081",
    "secure": false,
    "changeOrigin": true
  },
  "/api/notas": {
    "target": "http://localhost:8082",
    "secure": false,
    "changeOrigin": true
  },
  "/api/saude-faturamento": {
    "target": "http://localhost:8082",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/saude-faturamento": "/health"
    }
  },
  "/api/fiscal": {
    "target": "http://localhost:8083",
    "secure": false,
    "changeOrigin": true
  }
}