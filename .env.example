# Copie para .env  ->  cp .env.example .env
# O .env real esta no .gitignore e nunca deve ser versionado.
#
# Estas sao TODAS as variaveis lidas pelo docker-compose.yml. As strings de
# conexao dos servicos nao ficam aqui: o compose as monta a partir de
# POSTGRES_USER e POSTGRES_PASSWORD e as entrega a cada container com o nome
# que a aplicacao espera (ESTOQUE_DATABASE_URL no Go, ConnectionStrings__Postgres
# e Estoque__BaseUrl no C#). Repeti-las neste arquivo so criaria duas fontes da
# verdade para a mesma credencial.

# ── PostgreSQL ─────────────────────────────────────────────────────────
# Trocar a senha so tem efeito na PRIMEIRA subida: o Postgres a grava no
# volume durante o initdb. Para trocar depois: podman-compose down -v
POSTGRES_USER=korp
POSTGRES_PASSWORD=korp_dev_senha
POSTGRES_PORT=5432

# ── Portas ─────────────────────────────────────────────────────────────
# Todas publicadas apenas em 127.0.0.1, exceto FRONTEND_PORT -- que e a
# aplicacao, e a unica que fica exposta na rede.
ESTOQUE_PORT=8081
FATURAMENTO_PORT=8082
# Obrigatoria: e a unica porta cujo default o podman-compose interpreta como
# inteiro, quebrando a interpolacao com TypeError se a variavel faltar.
FISCAL_PORT=8083
FRONTEND_PORT=8080
